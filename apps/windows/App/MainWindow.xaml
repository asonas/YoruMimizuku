<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="YoruMimizuku.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:views="using:YoruMimizuku.App.Views">

    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.Resources>
            <Style x:Key="DetailBarButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource AppTertiaryTextBrush}" />
            </Style>
        </Grid.Resources>
        <!-- Login gate; swapped for the main shell after authentication. -->
        <ContentControl x:Name="LoginHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

        <Grid x:Name="ShellRoot" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Open while this window's account waits to sign in again (ADR 0018). -->
            <muxc:InfoBar x:Name="ReauthBar" Grid.Row="0" Severity="Warning" IsClosable="False"
                          Title="セッションが期限切れです">
                <muxc:InfoBar.ActionButton>
                    <Button Content="再ログイン" Click="OnReauthClick" />
                </muxc:InfoBar.ActionButton>
            </muxc:InfoBar>

            <muxc:NavigationView
                x:Name="Nav"
                Grid.Row="1"
                PaneDisplayMode="Left"
                OpenPaneLength="210"
                IsBackButtonVisible="Collapsed"
                IsSettingsVisible="True"
                SelectionChanged="OnNavSelectionChanged">

                <!-- The macOS toolbar search (Ctrl+F): results show in the timeline
                     column without saving; selecting any row below discards them. -->
                <muxc:NavigationView.AutoSuggestBox>
                    <AutoSuggestBox x:Name="SearchBox" PlaceholderText="検索" QueryIcon="Find"
                                    AutomationProperties.Name="検索" QuerySubmitted="OnSearchSubmitted" />
                </muxc:NavigationView.AutoSuggestBox>

                <muxc:NavigationView.PaneFooter>
                    <Button x:Name="AccountFooter" Padding="12,8" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Visibility="Collapsed" ToolTipService.ToolTip="アカウント">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PersonPicture x:Name="AccountAvatar" Grid.Column="0" Width="28" Height="28" />
                            <TextBlock x:Name="AccountHandle" Grid.Column="1" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Opacity="0.8" />
                            <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="10" Opacity="0.6" />
                        </Grid>
                        <Button.Flyout>
                            <MenuFlyout x:Name="AccountMenu" Opening="OnAccountMenuOpening" />
                        </Button.Flyout>
                    </Button>
                </muxc:NavigationView.PaneFooter>

                <!-- Three panes (ADR 0026): the sidebar above, then the selected
                     timeline and the detail pane, at the prototype's 400 : 628 in a
                     1240-wide window. The timeline may grow to 960 so a wide window
                     reaches the media rail (TimelineLayout). -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="TimelineColumn" Width="2*" MinWidth="360" MaxWidth="960" />
                        <ColumnDefinition x:Name="DetailColumn" Width="3*" MinWidth="320" />
                    </Grid.ColumnDefinitions>

                    <ContentControl x:Name="ContentHost"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" />

                    <Grid x:Name="DetailPane" Grid.Column="1" Background="{ThemeResource AppBackgroundBrush}"
                          BorderBrush="{ThemeResource AppHairlineBrush}" BorderThickness="1,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border x:Name="DetailBar" Height="39" Padding="8,0" Visibility="Collapsed"
                                BorderBrush="{ThemeResource AppHairlineBrush}" BorderThickness="0,0,0,1">
                            <Grid ColumnSpacing="2" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Click="OnDetailCloseClick" Style="{StaticResource DetailBarButtonStyle}"
                                        ToolTipService.ToolTip="閉じる" AutomationProperties.Name="閉じる">
                                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                                </Button>
                                <TextBlock x:Name="DetailTitle" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource AppTextBrush}" />
                                <!-- A conversation's スレッド / レコード switch, as in the prototype. -->
                                <SelectorBar x:Name="DetailTabs" Grid.Column="2" Visibility="Collapsed"
                                             Padding="0" SelectionChanged="OnDetailTabChanged">
                                    <SelectorBarItem x:Name="ThreadTabItem" Text="スレッド" />
                                    <SelectorBarItem x:Name="RecordTabItem" Text="レコード" />
                                </SelectorBar>
                            </Grid>
                        </Border>

                        <ContentControl x:Name="DetailHost" Grid.Row="1"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch" />

                        <!-- Nothing open: the prototype's faint two-lens mark. -->
                        <Grid x:Name="DetailEmpty" Grid.RowSpan="2" Width="40" Height="26"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.35"
                              AutomationProperties.AccessibilityView="Raw">
                            <Ellipse Width="26" Height="26" HorizontalAlignment="Left"
                                     Stroke="{ThemeResource AppTertiaryTextBrush}" StrokeThickness="1.5" />
                            <Ellipse Width="26" Height="26" HorizontalAlignment="Right"
                                     Stroke="{ThemeResource AppTertiaryTextBrush}" StrokeThickness="1.5" />
                        </Grid>
                    </Grid>
                </Grid>
            </muxc:NavigationView>
        </Grid>

        <!-- In-app confirmation pill (e.g. after copying a link), above every pane. -->
        <views:ToastView HorizontalAlignment="Center" VerticalAlignment="Bottom"
                         Margin="20,20,20,28" Canvas.ZIndex="10" />
    </Grid>
</Window>
