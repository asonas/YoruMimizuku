<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="YoruMimizuku.App.Views.ConversationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="12">
        <StackPanel Spacing="10">
            <!-- Ancestor (reply parent); a tap re-anchors the pane on it. A Border, not a
                 Button, so the links in its body get their clicks (a Button captures the
                 pointer). -->
            <Border x:Name="ParentCard" Visibility="Collapsed" Tapped="OnParentTapped"
                    Padding="11,5" CornerRadius="4" BorderThickness="1"
                    BorderBrush="{ThemeResource AppHairlineBrush}" Background="{ThemeResource AppRowHoverBrush}">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="ParentAuthor" FontWeight="SemiBold" Opacity="0.8" />
                    <RichTextBlock x:Name="ParentBody" TextWrapping="Wrap" Opacity="0.7"
                                   IsTextSelectionEnabled="False" />
                </StackPanel>
            </Border>

            <Border x:Name="FocusedCard" BorderThickness="2,0,0,0" Padding="10,2">
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <PersonPicture x:Name="FocusedAvatar" Grid.Column="0" Width="36" Height="36"
                                       Tapped="OnFocusedAvatarTapped" />
                        <!-- Name and handle, then the time in its own column so a long
                             name is cut off instead of the time. -->
                        <Grid Grid.Column="1" ColumnSpacing="6" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="FocusedAuthor" FontWeight="SemiBold" />
                                <TextBlock x:Name="FocusedHandle" Opacity="0.6" />
                            </StackPanel>
                            <TextBlock x:Name="FocusedTime" Grid.Column="1" FontSize="12" FontFamily="Consolas"
                                       Foreground="{ThemeResource AppTertiaryTextBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <RichTextBlock x:Name="FocusedBody" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="24" Margin="0,3,0,0">
                        <Button Click="OnFocusedReplyClick" Background="Transparent"
                                BorderThickness="0" Padding="2" ToolTipService.ToolTip="返信">
                            <FontIcon Glyph="&#xE97A;" FontSize="13" Foreground="{ThemeResource AppTertiaryTextBrush}" />
                        </Button>
                        <Button x:Name="LikeButton" Click="OnFocusedLikeClick" Background="Transparent"
                                BorderThickness="0" Padding="2" ToolTipService.ToolTip="いいね">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon x:Name="LikeGlyph" FontSize="13" />
                                <TextBlock x:Name="LikeCount" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnFocusedCopyLinkClick" Background="Transparent"
                                BorderThickness="0" Padding="2" ToolTipService.ToolTip="リンクをコピー">
                            <FontIcon Glyph="&#xE71B;" FontSize="13" Foreground="{ThemeResource AppTertiaryTextBrush}" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Descendant reply tree, populated imperatively in RenderReplies(). -->
            <StackPanel x:Name="RepliesHost" Spacing="6" />

            <ProgressRing x:Name="Spinner" IsActive="False" HorizontalAlignment="Center" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
