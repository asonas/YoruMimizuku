<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>YoruMimizuku.App.Interop.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Interop\YoruMimizuku.App.Interop.csproj" />
  </ItemGroup>

  <!-- The core tests' HTTP stub and fake AT Protocol servers, so these tests reach the
       XRPC and OAuth boundaries the same way. -->
  <ItemGroup>
    <Compile Include="..\Core.Tests\StubHttp.cs" Link="StubHttp.cs" />
    <Compile Include="..\Core.Tests\OAuth\FakeAtproto.cs" Link="FakeAtproto.cs" />
    <Compile Include="..\Core.Tests\OAuth\ScriptedHandler.cs" Link="ScriptedHandler.cs" />
    <Compile Include="..\Core.Tests\OAuth\DecodedProof.cs" Link="DecodedProof.cs" />
    <Compile Include="..\Core.Tests\Accounts\AccountTestSupport.cs" Link="AccountTestSupport.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
